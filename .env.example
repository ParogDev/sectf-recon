APP_NAME="SECTF Recon"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=sectf
DB_USERNAME=sectf
DB_PASSWORD=sectf

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Host ports (compose.yaml)
APP_PORT=8080
REVERB_HOST_PORT=8081

# Never "cookie": the pending OAuth authorization (~3.6 KB) overflows it silently.
# SESSION_DRIVER above is redis for that reason.

REVERB_APP_ID=sectf
REVERB_APP_KEY=sectf-key
REVERB_APP_SECRET=sectf-secret
# Where the *browser* reaches Reverb. Behind Tailscale Serve (see docs/CONTESTANT.md):
#   tailscale serve --bg --https=443 http://127.0.0.1:8080   (app; also set APP_URL=https://<host>)
#   tailscale serve --bg --https=8443 http://127.0.0.1:8081  (reverb; REVERB_HOST=<host>, PORT=8443, SCHEME=https)
# then rebuild assets: VITE_REVERB_* are baked into the bundle.
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
# Where the *server* (app container) reaches Reverb.
REVERB_SERVER_HOST=reverb
REVERB_SERVER_PORT=8081
# Where the app/worker containers publish broadcasts (config/broadcasting.php).
REVERB_PUBLISH_HOST=reverb
REVERB_PUBLISH_PORT=8081
REVERB_PUBLISH_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Docker: run containers as the host user so bind-mounted files stay yours (id -u / id -g)
HOST_UID=1000
HOST_GID=1000

# Project path as you see it on your machine; shown in the app so you know where exports land (set by scripts/bootstrap.sh)
HOST_PROJECT_DIR=
